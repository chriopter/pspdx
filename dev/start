#!/bin/sh
# Builds the client and opens it in PPSSPP, as one instance that outlives
# this shell. Stale instances are stopped first: two at once write the same
# files and play the same tune, slightly apart.
#
#   dev/start            build if needed, start
#   dev/start --reset    also forget the seed: the sweep runs, as on a new PSP
#   dev/start --no-build
#
# The stick gets what a run needs and PPSSPP does not provide: the system
# font (PPSSPP has it but does not mount flash0 for the guest), the clips
# from the catalog repo next door if there is one, and a seed, so the client
# starts the way a PSP does after its first run. Nothing here is real
# entropy; a PSP that has run this build is not one to sign with.
set -e
HERE="$(cd "$(dirname "$0")/.." && pwd)"
APP="$HERE/app"
MS="$HOME/.var/app/org.ppsspp.PPSSPP/config/ppsspp"
RESET=0
BUILD=1
for arg in "$@"; do
	case "$arg" in
		--reset) RESET=1 ;;
		--no-build) BUILD=0 ;;
		*) echo "unknown option $arg" >&2; exit 2 ;;
	esac
done

if [ "$BUILD" = 1 ]; then
	(cd "$APP" && docker run --rm -v "$PWD:/src" -w /src pspdev/pspdev:latest make 2>&1 \
		| grep -E 'error|EBOOT\.PBP' || true)
fi
[ -f "$APP/EBOOT.PBP" ] || { echo "no EBOOT.PBP" >&2; exit 1; }

mkdir -p "$MS/PSP/GAME/pspdx" "$MS/PSP/PSPDX/font" "$MS/PSP/PSPDX/cache"
cp "$APP/EBOOT.PBP" "$MS/PSP/GAME/pspdx/"

FONTS="$(flatpak info --show-location org.ppsspp.PPSSPP 2>/dev/null)/files/share/ppsspp/assets/flash0/font"
[ -f "$FONTS/ltn8.pgf" ] && cp "$FONTS/ltn8.pgf" "$MS/PSP/PSPDX/font/ltn8.pgf"

for clip in "$HERE"/../pspdx-catalog/apps/*/video.mp4 "$HERE"/catalog/apps/*/video.mp4; do
	[ -f "$clip" ] || continue
	cp "$clip" "$MS/PSP/PSPDX/cache/$(basename "$(dirname "$clip")").mp4"
done

rm -f "$MS/PSPDX.REPLAY" "$MS/PSPDX.KEYS" "$MS/PSPDX.INSTALL"
if [ "$RESET" = 1 ]; then
	rm -f "$MS/PSPDX.SEED"
else
	[ -f "$MS/PSPDX.SEED" ] || printf 'PSPDX-TEST-SEED-0000' >"$MS/PSPDX.SEED"
fi

systemctl --user stop pspdx-ppsspp 2>/dev/null || true
pkill -x PPSSPPSDL 2>/dev/null || true
sleep 1
systemd-run --user --collect --quiet --unit=pspdx-ppsspp \
  --setenv=SDL_VIDEODRIVER=wayland --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
  flatpak run --socket=wayland --share=network --filesystem="$MS" \
  org.ppsspp.PPSSPP --fullscreen=0 "$MS/PSP/GAME/pspdx/EBOOT.PBP"
sleep 3
WS="$(hyprctl clients -j 2>/dev/null | python3 -c "import sys,json; print(*(c['workspace']['name'] for c in json.load(sys.stdin) if 'ppsspp' in c['class'].lower()))" 2>/dev/null || true)"
echo "PPSSPP is up${WS:+ on workspace $WS}. Stop it with: systemctl --user stop pspdx-ppsspp"
